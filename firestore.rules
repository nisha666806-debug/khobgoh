rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =========================================================
    // AUTH HELPERS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function manager() {
      return signedIn()
        && userDoc().data.role == "manager";
    }

    function supervisor() {
      return signedIn()
        && userDoc().data.role == "supervisor";
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{uid} {

      // User can read own profile.
      // Manager can read all users.
      allow read: if signedIn()
        && (request.auth.uid == uid || manager());

      // Only manager can create/update/delete users.
      allow create, update, delete: if manager();
    }


    // =========================================================
    // STUDENTS
    // =========================================================

    match /students/{studentId} {

      // Manager sees all students.
      // Supervisor sees only students assigned to him.
      allow read: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
        );

      // Only manager can create/update/delete students.
      allow create, update, delete: if manager();
    }


    // =========================================================
    // ROOMS
    // =========================================================

    match /rooms/{roomId} {

      // Manager sees all rooms.
      // Supervisor sees only his assigned rooms.
      allow read: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
        );

      // Only manager can create/update/delete rooms.
      allow create, update, delete: if manager();
    }


    // =========================================================
    // PLACEMENTS
    // =========================================================

    match /placements/{placementId} {

      // Manager can see everything.
      // Supervisor can see placements belonging to his rooms.
      allow read: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
        );

      // Manager can always modify.
      // Supervisor can modify only his own placements.
      allow create, update: if manager()
        || (
          supervisor()
          && request.resource.data.supervisorId == request.auth.uid
        );

      allow delete: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
        );
    }


    // =========================================================
    // ATTENDANCE
    // =========================================================

    match /attendance/{attendanceId} {

      // Manager sees all.
      // Supervisor sees only his own records.
      allow read: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
        );

      // Manager or supervisor can create.
      allow create: if manager()
        || (
          supervisor()
          && request.resource.data.supervisorId == request.auth.uid
        );

      // Manager can update everything.
      // Supervisor can update only his own records.
      allow update: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
          && request.resource.data.supervisorId == request.auth.uid
        );

      // Only manager can delete.
      allow delete: if manager();
    }


    // =========================================================
    // VIOLATIONS
    // =========================================================

    match /violations/{violationId} {

      allow read: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
        );

      allow create: if manager()
        || (
          supervisor()
          && request.resource.data.supervisorId == request.auth.uid
        );

      allow update: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
          && request.resource.data.supervisorId == request.auth.uid
        );

      allow delete: if manager();
    }


    // =========================================================
    // CLEANLINESS
    // =========================================================

    match /cleanliness_inspections/{inspectionId} {

      allow read: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
        );

      allow create: if manager()
        || (
          supervisor()
          && request.resource.data.supervisorId == request.auth.uid
        );

      allow update: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
          && request.resource.data.supervisorId == request.auth.uid
        );

      allow delete: if manager();
    }
  }
}
