rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function manager() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "manager";
    }
    function supervisor() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "supervisor";
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || manager());
      allow create, update, delete: if manager();
    }
    match /students/{id} {
      allow read: if manager() || supervisor();
      allow write: if manager();
    }
    match /rooms/{id} {
      allow read: if manager() || supervisor();
      allow write: if manager();
    }
    match /placements/{id} {
      allow read: if manager() || supervisor();
      allow write: if manager() || supervisor();
    }
    match /attendance/{id} {
      allow read: if manager() || supervisor();
      allow create, update: if manager() || supervisor();
      allow delete: if manager();
    }
    match /violations/{id} {
      allow read: if manager() || supervisor();
      allow create: if manager() || supervisor();
      allow update, delete: if manager();
    }
    match /cleanliness_inspections/{id} {
      allow read: if manager() || supervisor();
      allow create: if manager() || supervisor();
      allow update, delete: if manager();
    }
  }
}