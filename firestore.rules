rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read, write: if signedIn();
    }

    match /invitations/{inviteId} {
      allow read, write: if true;
    }

    match /students/{studentId} {
      allow read, write: if signedIn();
    }

    match /rooms/{roomId} {
      allow read, write: if signedIn();
    }

    match /attendance/{attendanceId} {
      allow read, write: if signedIn();
    }

    match /violations/{violationId} {
      allow read, write: if signedIn();
    }

    match /cleanliness_inspections/{inspectionId} {
      allow read, write: if signedIn();
    }

    match /activities/{activityId} {
      allow read, write: if signedIn();
    }

    match /tea_recipes/{recipeId} {
      allow read, write: if signedIn();
    }

    match /duty_roster/{dayId} {
      allow read, write: if signedIn();
    }

    match /settings/{settingId} {
      allow read, write: if signedIn();
    }

    match /app_settings/{settingId} {
      allow read, write: if signedIn();
    }

    match /placements/{placementId} {
      allow read, write: if signedIn();
    }

    match /residences/{residenceId} {
      allow read, write: if signedIn();
    }

    match /stage_confirmations/{confirmationId} {
      allow read, write: if signedIn();
    }

    match /daily_schedule/{activityId} {
      allow read, write: if signedIn();
    }

    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}
