rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function manager() {
      return signedIn()
        && myUser().data.role == "manager";
    }

    function supervisor() {
      return signedIn()
        && myUser().data.role == "supervisor";
    }


    // =====================================================
    // USERS
    // =====================================================

    match /users/{uid} {

      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || manager()
        );

      // Manager can manage users.
      //
      // A new supervisor can create ONLY his own profile
      // AND only when a valid invitation exists.
      allow create: if manager()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == "supervisor"
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.inviteCode is string
          && get(
            /databases/$(database)/documents/invitations/$(request.resource.data.inviteCode)
          ).data.email == request.auth.token.email
          && get(
            /databases/$(database)/documents/invitations/$(request.resource.data.inviteCode)
          ).data.status == "pending"
        );

      allow update, delete: if manager();
    }


    // =====================================================
    // INVITATIONS
    // =====================================================

    match /invitations/{inviteId} {

      // Only Manager creates/changes/deletes invitations.
      allow create, update, delete: if manager();

      // Nobody directly reads invitation documents.
      allow read: if false;
    }


    // =====================================================
    // STUDENTS
    // =====================================================

    match /students/{studentId} {

      allow read: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
        );

      allow create, update, delete: if manager();
    }


    // =====================================================
    // ROOMS
    // =====================================================

    match /rooms/{roomId} {

      allow read: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
        );

      allow create, update, delete: if manager();
    }


    // =====================================================
    // PLACEMENTS
    // =====================================================

    match /placements/{placementId} {

      allow read: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
        );

      allow create, update: if manager()
        || (
          supervisor()
          && request.resource.data.supervisorId == request.auth.uid
        );

      allow delete: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
        );
    }


    // =====================================================
    // ATTENDANCE
    // =====================================================

    match /attendance/{attendanceId} {

      allow read: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
        );

      allow create: if manager()
        || (
          supervisor()
          && request.resource.data.supervisorId == request.auth.uid
        );

      allow update: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
          && request.resource.data.supervisorId == request.auth.uid
        );

      allow delete: if manager();
    }


    // =====================================================
    // VIOLATIONS
    // =====================================================

    match /violations/{violationId} {

      allow read: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
        );

      allow create: if manager()
        || (
          supervisor()
          && request.resource.data.supervisorId == request.auth.uid
        );

      allow update: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
          && request.resource.data.supervisorId == request.auth.uid
        );

      allow delete: if manager();
    }


    // =====================================================
    // CLEANLINESS
    // =====================================================

    match /cleanliness_inspections/{inspectionId} {

      allow read: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
        );

      allow create: if manager()
        || (
          supervisor()
          && request.resource.data.supervisorId == request.auth.uid
        );

      allow update: if manager()
        || (
          supervisor()
          && resource.data.supervisorId == request.auth.uid
          && request.resource.data.supervisorId == request.auth.uid
        );

      allow delete: if manager();
    }
  }
}
